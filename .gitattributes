* text=auto

# Windows-Skripte brauchen CRLF.
#
# Bewusst OHNE working-tree-encoding: UTF-8 nach UTF-8 ist eine Umwandlung in
# sich selbst und schützt die BOM nicht — die überlebt ohnehin als gewöhnliche
# Bytes. Dafür ignorieren JGit- und libgit2-Clients (GitHub-Web-Editor, manche
# Oberflächen) das Attribut, und Git bricht hart ab, sobald es eine Datei als
# ungültiges UTF-8 einstuft.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.xaml  text eol=crlf
*.wsb   text eol=crlf

*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf

# Binaries
*.ttf   binary
*.ico   binary
*.png   binary

# Gehört nicht in ein "git archive"
docs/           export-ignore
tools/*.ps1     export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.editorconfig   export-ignore
