<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="// KI-ENTFERNUNG" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="Copilot, Recall und Co." Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="Erst sperren, dann entfernen. Die Sperren wirken auch vorbeugend, falls ein Funktionsupdate KI-Bestandteile nachliefert." />

    <ItemsControl Name="AiNotices" Margin="0,0,0,14" />

    <!-- Bestandsaufnahme -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <TextBlock Text="// BESTANDSAUFNAHME" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="AiScanTitle" Text="Wird geprüft..." Style="{DynamicResource WzCardTitle}" TextWrapping="Wrap" />
            <StackPanel Name="AiScanRows" />
            <Button Name="AiBtnScan" Style="{DynamicResource WzBtnSecondary}" Margin="0,12,0,0"
                    HorizontalAlignment="Left" Content="Erneut suchen" />
        </StackPanel>
    </Border>

    <!-- Aktionsleiste -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="AiSelectionCount" Text="0 ausgewählt" Style="{DynamicResource WzValue}"
                               VerticalAlignment="Center" Foreground="{DynamicResource WzCyan}" />
                    <TextBlock Name="AiStatusHint" Text="Zustand wird geprüft..." Style="{DynamicResource WzLabel}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="AiBtnRecommended" Style="{DynamicResource WzBtnGhost}" Content="empfohlene" Margin="0,0,4,0" />
                    <Button Name="AiBtnNone" Style="{DynamicResource WzBtnGhost}" Content="keine" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,16,0,0">
                <Button Name="AiBtnApply" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,0"
                        Content="Auswahl anwenden" />
                <Button Name="AiBtnUndo" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,0"
                        Content="Änderungen zurücknehmen" />
                <Button Name="AiBtnRefresh" Style="{DynamicResource WzBtnSecondary}"
                        Content="Zustand neu prüfen" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <StackPanel Name="AiCategories" />
</StackPanel>
