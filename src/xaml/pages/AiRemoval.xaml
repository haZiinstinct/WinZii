<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.ai.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.ai.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.ai.lead}" />

    <ItemsControl Name="AiNotices" Margin="0,0,0,14" />

    <!-- Bestandsaufnahme -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.ai.scanEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="AiScanTitle" Text="{DynamicResource L.ai.scanTitle}" Style="{DynamicResource WzCardTitle}" TextWrapping="Wrap" />
            <StackPanel Name="AiScanRows" />
            <Button Name="AiBtnScan" Style="{DynamicResource WzBtnSecondary}" Margin="0,12,0,0"
                    HorizontalAlignment="Left" Content="{DynamicResource L.ai.btnScan}" />
        </StackPanel>
    </Border>

    <!-- Aktionsleiste -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="AiSelectionCount" Text="{DynamicResource L.ai.selectionCount}" Style="{DynamicResource WzValue}"
                               VerticalAlignment="Center" Foreground="{DynamicResource WzCyan}" />
                    <TextBlock Name="AiStatusHint" Text="{DynamicResource L.ai.stateHint}" Style="{DynamicResource WzLabel}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="AiBtnRecommended" Style="{DynamicResource WzBtnGhost}" Content="{DynamicResource L.ai.btnRecommended}" Margin="0,0,4,0" />
                    <Button Name="AiBtnNone" Style="{DynamicResource WzBtnGhost}" Content="{DynamicResource L.ai.btnNone}" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,16,0,0">
                <Button Name="AiBtnApply" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,0"
                        Content="{DynamicResource L.ai.btnApply}" />
                <Button Name="AiBtnUndo" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,0"
                        Content="{DynamicResource L.ai.btnUndo}" />
                <Button Name="AiBtnRefresh" Style="{DynamicResource WzBtnSecondary}"
                        Content="{DynamicResource L.ai.btnRefresh}" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <StackPanel Name="AiCategories" />
</StackPanel>
