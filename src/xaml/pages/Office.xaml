<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.off.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.off.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.off.lead}" />

    <!-- Vorhandene Installation -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.off.installedEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="OffInstalledTitle" Text="{DynamicResource L.off.installedTitle}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="OffInstalledRows" />
        </StackPanel>
    </Border>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Auswahl -->
        <Border Grid.Column="0" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.off.choiceEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="{DynamicResource L.off.choiceTitle}" Style="{DynamicResource WzCardTitle}" />

                <TextBlock Text="{DynamicResource L.off.variantLabel}" Style="{DynamicResource WzLabel}" Margin="0,6,0,4" />
                <ComboBox Name="OffVariant" Style="{DynamicResource WzComboBox}" />
                <TextBlock Name="OffVariantNote" Style="{DynamicResource WzHint}" Margin="0,6,0,0" />

                <TextBlock Text="{DynamicResource L.off.languageLabel}" Style="{DynamicResource WzLabel}" Margin="0,14,0,4" />
                <ComboBox Name="OffLanguage" Style="{DynamicResource WzComboBox}" />

                <StackPanel Name="OffKeyPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource L.off.keyLabel}" Style="{DynamicResource WzLabel}" Margin="0,0,0,4" />
                    <TextBox Name="OffKey" Style="{DynamicResource WzTextBox}" />
                    <TextBlock Style="{DynamicResource WzHint}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{DynamicResource L.off.keyHint}" />
                </StackPanel>

                <TextBlock Name="OffCacheHint" Style="{DynamicResource WzHint}" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- Programme -->
        <Border Grid.Column="2" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.off.appsEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="{DynamicResource L.off.appsTitle}" Style="{DynamicResource WzCardTitle}" />
                <StackPanel Name="OffApps" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Aktionen -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.off.actionEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="{DynamicResource L.off.actionTitle}" Style="{DynamicResource WzCardTitle}" />
            <WrapPanel>
                <Button Name="OffBtnRemove" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.off.btnRemove}" />
                <Button Name="OffBtnInstall" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.off.btnInstall}" />
                <Button Name="OffBtnDownload" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.off.btnDownload}" />
                <Button Name="OffBtnXml" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.off.btnXml}" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.off.libreEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="{DynamicResource L.off.libreTitle}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                       Text="{DynamicResource L.off.libreLead}" />
            <Button Name="OffBtnLibre" Style="{DynamicResource WzBtnSecondary}" HorizontalAlignment="Left"
                    Content="{DynamicResource L.off.btnLibre}" />
        </StackPanel>
    </Border>
</StackPanel>
