<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="// OFFICE" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="Office einrichten" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="Microsoft Office über das offizielle Bereitstellungswerkzeug — oder LibreOffice, wenn keine Lizenz vorhanden ist." />

    <ItemsControl Name="OffNotices" Margin="0,0,0,14" />

    <!-- Vorhandene Installation -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <TextBlock Text="// VORHANDEN" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="OffInstalledTitle" Text="wird geprüft..." Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="OffInstalledRows" />
        </StackPanel>
    </Border>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Auswahl -->
        <Border Grid.Column="0" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="// AUSWAHL" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="Version und Sprache" Style="{DynamicResource WzCardTitle}" />

                <TextBlock Text="Ausgabe" Style="{DynamicResource WzLabel}" Margin="0,6,0,4" />
                <ComboBox Name="OffVariant" Style="{DynamicResource WzComboBox}" />
                <TextBlock Name="OffVariantNote" Style="{DynamicResource WzHint}" Margin="0,6,0,0" />

                <TextBlock Text="Sprache" Style="{DynamicResource WzLabel}" Margin="0,14,0,4" />
                <ComboBox Name="OffLanguage" Style="{DynamicResource WzComboBox}" />

                <TextBlock Name="OffCacheHint" Style="{DynamicResource WzHint}" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- Programme -->
        <Border Grid.Column="2" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="// UMFANG" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="Welche Programme" Style="{DynamicResource WzCardTitle}" />
                <StackPanel Name="OffApps" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Aktionen -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="// AKTION" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="Microsoft Office" Style="{DynamicResource WzCardTitle}" />
            <WrapPanel>
                <Button Name="OffBtnInstall" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,8"
                        Content="Office installieren" />
                <Button Name="OffBtnDownload" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Auf Datenträger laden" />
                <Button Name="OffBtnXml" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Konfiguration ansehen" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Text="// ALTERNATIVE" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="LibreOffice" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                       Text="Kostenfrei und ohne Lizenzschlüssel. Öffnet und speichert auch die Formate von Microsoft Office — für die meisten Privatkunden völlig ausreichend." />
            <Button Name="OffBtnLibre" Style="{DynamicResource WzBtnSecondary}" HorizontalAlignment="Left"
                    Content="LibreOffice installieren" />
        </StackPanel>
    </Border>
</StackPanel>
