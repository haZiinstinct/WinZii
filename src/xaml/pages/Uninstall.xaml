<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.unin.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.unin.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.unin.lead}" />

    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Name="UninstallTitle" Text="{DynamicResource L.unin.listTitle}" Style="{DynamicResource WzCardTitle}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Name="UninstallSearch" Grid.Column="0" Style="{DynamicResource WzTextBox}"
                         ToolTip="{DynamicResource L.unin.tipFilter}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Name="UninstallBtnScan" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,0"
                            Content="{DynamicResource L.unin.btnList}" />
                    <Button Name="UninstallBtnRemove" Style="{DynamicResource WzBtnDanger}"
                            Content="{DynamicResource L.unin.btnRemove}" IsEnabled="False" />
                </StackPanel>
            </Grid>

            <StackPanel Name="UninstallList" />
        </StackPanel>
    </Border>
</StackPanel>
