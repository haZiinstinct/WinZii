<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.data.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.data.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.data.lead}" />

    <ItemsControl Name="DataNotices" Margin="0,0,0,14" />

    <!-- Steuerung -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.data.scanEyebrow}" Style="{DynamicResource WzEyebrow}" />
                    <TextBlock Name="DataTitle" Text="{DynamicResource L.data.notChecked}" Style="{DynamicResource WzCardTitle}" />
                </StackPanel>
                <Button Name="DataBtnScan" Style="{DynamicResource WzBtnPrimary}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Content="{DynamicResource L.data.btnScan}" />
            </Grid>
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,0"
                       Text="{DynamicResource L.data.scanHint}" />
        </StackPanel>
    </Border>

    <!-- Benutzerprofile -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.data.profilesEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DataProfilesTitle" Text="{DynamicResource L.data.notChecked}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.data.profilesHint}" />
            <StackPanel Name="DataProfiles" />
        </StackPanel>
    </Border>

    <!-- OneDrive -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.data.oneDriveEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DataOneDriveTitle" Text="{DynamicResource L.data.notChecked}" Style="{DynamicResource WzCardTitle}" />
            <ItemsControl Name="DataOneDriveNotice" Margin="0,4,0,6" />
            <StackPanel Name="DataOneDrive" />
            <Button Name="DataBtnHydrate" Style="{DynamicResource WzBtnSecondary}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" IsEnabled="False" Content="{DynamicResource L.data.btnHydrate}" />
        </StackPanel>
    </Border>

    <!-- Dateiumzug -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.data.moveEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DataMoveTitle" Text="{DynamicResource L.data.notChecked}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.data.moveHint}" />
            <StackPanel Name="DataMove" />
            <Button Name="DataBtnMove" Style="{DynamicResource WzBtnSecondary}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" IsEnabled="False" Content="{DynamicResource L.data.btnCopy}" />
        </StackPanel>
    </Border>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Outlook -->
        <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.data.outlookEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DataOutlookTitle" Text="{DynamicResource L.data.notChecked}" Style="{DynamicResource WzCardTitle}" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                           Text="{DynamicResource L.data.outlookHint}" />
                <StackPanel Name="DataOutlook" />
            </StackPanel>
        </Border>

        <!-- Browser -->
        <Border Grid.Row="0" Grid.Column="2" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.data.browserEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DataBrowsersTitle" Text="{DynamicResource L.data.notChecked}" Style="{DynamicResource WzCardTitle}" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                           Text="{DynamicResource L.data.browserHint}" />
                <StackPanel Name="DataBrowsers" />
                <Button Name="DataBtnBookmarks" Style="{DynamicResource WzBtnSecondary}" Margin="0,10,0,0"
                        HorizontalAlignment="Left" Content="{DynamicResource L.data.btnBookmarks}" IsEnabled="False" />
            </StackPanel>
        </Border>

        <!-- Drucker und Netzlaufwerke -->
        <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.data.devicesEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DataDevicesTitle" Text="{DynamicResource L.data.notChecked}" Style="{DynamicResource WzCardTitle}" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                           Text="{DynamicResource L.data.devicesHint}" />
                <StackPanel Name="DataDevices" />
                <Button Name="DataBtnDevices" Style="{DynamicResource WzBtnSecondary}" Margin="0,10,0,0"
                        HorizontalAlignment="Left" IsEnabled="False" Content="{DynamicResource L.data.btnDevices}" />
            </StackPanel>
        </Border>

        <!-- Zugangsdaten -->
        <Border Grid.Row="1" Grid.Column="2" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.data.keysEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DataKeysTitle" Text="{DynamicResource L.data.notChecked}" Style="{DynamicResource WzCardTitle}" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                           Text="{DynamicResource L.data.keysHint}" />
                <StackPanel Name="DataKeys" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Name="DataBtnWlan" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,8"
                            Content="{DynamicResource L.data.btnWlan}" IsEnabled="False" />
                    <Button Name="DataBtnBitLocker" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,8"
                            Content="{DynamicResource L.data.btnBitLocker}" IsEnabled="False" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Übernahme-Bericht -->
    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.data.reportEyebrow}" Style="{DynamicResource WzEyebrow}" />
                    <TextBlock Text="{DynamicResource L.data.reportTitle}" Style="{DynamicResource WzCardTitle}" />
                </StackPanel>
                <Button Name="DataBtnReport" Style="{DynamicResource WzBtnPrimary}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Content="{DynamicResource L.data.btnReport}" IsEnabled="False" />
            </Grid>
            <TextBlock Style="{DynamicResource WzHint}"
                       Text="{DynamicResource L.data.reportHint}" />
        </StackPanel>
    </Border>
</StackPanel>
