<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.rest.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.rest.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.rest.lead}" />

    <ItemsControl Name="RstNotices" Margin="0,0,0,14" />

    <!-- Quelle -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.rest.sourceEyebrow}" Style="{DynamicResource WzEyebrow}" />
                    <TextBlock Name="RstSourceTitle" Text="{DynamicResource L.rest.sourceTitle}" Style="{DynamicResource WzCardTitle}" />
                </StackPanel>
                <Button Name="RstBtnScan" Style="{DynamicResource WzBtnPrimary}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Content="{DynamicResource L.rest.btnSearch}" />
            </Grid>
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.rest.sourceHint}" />
            <StackPanel Name="RstSources" />
        </StackPanel>
    </Border>

    <!-- WLAN -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.rest.wlanEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="RstWlanTitle" Text="{DynamicResource L.rest.noSource}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.rest.wlanHint}" />
            <StackPanel Name="RstWlan" />
            <Button Name="RstBtnWlan" Style="{DynamicResource WzBtnSecondary}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" IsEnabled="False" Content="{DynamicResource L.rest.btnWlan}" />
        </StackPanel>
    </Border>

    <!-- Lesezeichen -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.rest.bookmarksEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="RstMarksTitle" Text="{DynamicResource L.rest.noSource}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.rest.bookmarksHint}" />
            <StackPanel Name="RstMarks" />
            <Button Name="RstBtnMarks" Style="{DynamicResource WzBtnSecondary}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" IsEnabled="False" Content="{DynamicResource L.rest.btnBookmarks}" />
        </StackPanel>
    </Border>

    <!-- Drucker und Netzlaufwerke -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.rest.devicesEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="RstDevicesTitle" Text="{DynamicResource L.rest.noSource}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.rest.devicesHint}" />
            <StackPanel Name="RstDevices" />
            <WrapPanel Margin="0,10,0,0">
                <Button Name="RstBtnPrinters" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,0"
                        IsEnabled="False" Content="{DynamicResource L.rest.btnPrinters}" />
                <Button Name="RstBtnDrives" Style="{DynamicResource WzBtnSecondary}"
                        IsEnabled="False" Content="{DynamicResource L.rest.btnDrives}" />
            </WrapPanel>
        </StackPanel>
    </Border>

</StackPanel>
