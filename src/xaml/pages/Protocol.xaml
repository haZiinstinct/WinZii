<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="// PROTOKOLL" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="Sitzungsprotokoll" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="Jeder Arbeitsschritt wird mitgeschrieben — als Nachweis für den Kunden und als Gedächtnisstütze für dich." />

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource WzCard}">
            <StackPanel>
                <TextBlock Text="// UMFANG" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="ProtoCount" Text="0" Style="{DynamicResource WzValueBig}" />
                <TextBlock Text="protokollierte Schritte" Style="{DynamicResource WzLabel}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource WzCard}">
            <StackPanel>
                <TextBlock Text="// DAUER" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="ProtoDuration" Text="0 Min" Style="{DynamicResource WzValueBig}" />
                <TextBlock Name="ProtoStart" Text="seit Programmstart" Style="{DynamicResource WzLabel}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{DynamicResource WzCard}">
            <StackPanel>
                <TextBlock Text="// AUFFÄLLIGKEITEN" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="ProtoIssues" Text="0" Style="{DynamicResource WzValueBig}" />
                <TextBlock Text="Warnungen und Fehler" Style="{DynamicResource WzLabel}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>

    <Border Style="{DynamicResource WzCardStatic}" Margin="0,14,0,0">
        <StackPanel>
            <TextBlock Text="// AUSGABE" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="Protokoll und Ablage" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Name="ProtoPathHint" Style="{DynamicResource WzHint}" Margin="0,0,0,14"
                       Text="Berichte werden auf dem WinZii-Datenträger abgelegt." />
            <WrapPanel>
                <Button Name="ProtoBtnExport" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,8"
                        Content="Protokoll als HTML sichern" />
                <Button Name="ProtoBtnOpenFolder" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Berichtsordner öffnen" />
                <Button Name="ProtoBtnOpenLog" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Textprotokoll öffnen" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <Border Style="{DynamicResource WzCardStatic}" Margin="0,14,0,0">
        <StackPanel>
            <TextBlock Text="// VERLAUF" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="Letzte Schritte" Style="{DynamicResource WzCardTitle}" />
            <ItemsControl Name="ProtoEntries" />
        </StackPanel>
    </Border>
</StackPanel>
