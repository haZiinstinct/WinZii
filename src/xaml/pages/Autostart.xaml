<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.auto.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.auto.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.auto.lead}" />

    <ItemsControl Name="AutoNotices" Margin="0,0,0,14" />

    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource L.auto.summaryEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="AutoCount" Text="—" Style="{DynamicResource WzValueBig}" />
                <TextBlock Name="AutoCountHint" Text="{DynamicResource L.auto.summaryHint}" Style="{DynamicResource WzLabel}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Name="AutoBtnRefresh" Style="{DynamicResource WzBtnSecondary}" Content="{DynamicResource L.auto.btnRefresh}" MinWidth="160" />
            </StackPanel>
        </Grid>
    </Border>

    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.auto.listEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="{DynamicResource L.auto.listHint}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="AutoItems" />
        </StackPanel>
    </Border>
</StackPanel>
