<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.apps.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.apps.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.apps.lead}" />

    <ItemsControl Name="AppsNotices" Margin="0,0,0,14" />

    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="AppsSelectionCount" Text="{DynamicResource L.apps.selectionCount}" Style="{DynamicResource WzValue}"
                               VerticalAlignment="Center" Foreground="{DynamicResource WzCyan}" />
                    <TextBlock Name="AppsOfflineHint" Text="" Style="{DynamicResource WzLabel}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="AppsBtnRecommended" Style="{DynamicResource WzBtnChip}" Content="{DynamicResource L.apps.btnRecommended}" Margin="0,0,4,0" />
                    <Button Name="AppsBtnNone" Style="{DynamicResource WzBtnChip}" Content="{DynamicResource L.apps.btnNone}" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,16,0,0">
                <Button Name="AppsBtnInstall" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,0"
                        IsEnabled="False" Content="{DynamicResource L.apps.btnInstall}" />
                <Button Name="AppsBtnDownload" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,0"
                        IsEnabled="False" Content="{DynamicResource L.apps.btnDownload}" />
                <Button Name="AppsBtnWinget" Style="{DynamicResource WzBtnSecondary}"
                        Content="{DynamicResource L.apps.btnBootstrap}" Visibility="Collapsed" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <!-- Was schon installiert ist, aber veraltet -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.apps.upgradeEyebrow}" Style="{DynamicResource WzEyebrow}" />
                    <TextBlock Name="AppsUpgradeTitle" Text="{DynamicResource L.apps.upgradeTitle}" Style="{DynamicResource WzCardTitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Name="AppsBtnUpgradeScan" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,8,0"
                            Content="{DynamicResource L.apps.btnUpgradeScan}" />
                    <Button Name="AppsBtnUpgradeAll" Style="{DynamicResource WzBtnChip}"
                            Content="{DynamicResource L.apps.btnUpgradeAll}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                       Text="{DynamicResource L.apps.upgradeHint}" />
            <StackPanel Name="AppsUpgradeList" />
            <Button Name="AppsBtnUpgrade" Style="{DynamicResource WzBtnPrimary}" Margin="0,12,0,0"
                    HorizontalAlignment="Left" IsEnabled="False" Content="{DynamicResource L.apps.btnUpgrade}" />
        </StackPanel>
    </Border>

    <StackPanel Name="AppsCategories" />
</StackPanel>
