<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.apps.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.apps.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.apps.lead}" />

    <ItemsControl Name="AppsNotices" Margin="0,0,0,14" />

    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="AppsSelectionCount" Text="{DynamicResource L.apps.selectionCount}" Style="{DynamicResource WzValue}"
                               VerticalAlignment="Center" Foreground="{DynamicResource WzCyan}" />
                    <TextBlock Name="AppsOfflineHint" Text="" Style="{DynamicResource WzLabel}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="AppsBtnRecommended" Style="{DynamicResource WzBtnGhost}" Content="{DynamicResource L.apps.btnRecommended}" Margin="0,0,4,0" />
                    <Button Name="AppsBtnNone" Style="{DynamicResource WzBtnGhost}" Content="{DynamicResource L.apps.btnNone}" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,16,0,0">
                <Button Name="AppsBtnInstall" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,0"
                        IsEnabled="False" Content="{DynamicResource L.apps.btnInstall}" />
                <Button Name="AppsBtnDownload" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,0"
                        IsEnabled="False" Content="{DynamicResource L.apps.btnDownload}" />
                <Button Name="AppsBtnWinget" Style="{DynamicResource WzBtnSecondary}"
                        Content="{DynamicResource L.apps.btnBootstrap}" Visibility="Collapsed" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <StackPanel Name="AppsCategories" />

    <!-- Zweiter Bereich: entfernen statt installieren -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,4,0,0">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.apps.uninstallEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="AppsUninstallTitle" Text="{DynamicResource L.apps.uninstallTitle}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                       Text="{DynamicResource L.apps.uninstallLead}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Name="AppsUninstallSearch" Grid.Column="0" Style="{DynamicResource WzTextBox}"
                         ToolTip="{DynamicResource L.apps.tipFilter}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Name="AppsBtnUninstallScan" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,0"
                            Content="{DynamicResource L.apps.btnList}" />
                    <Button Name="AppsBtnUninstall" Style="{DynamicResource WzBtnDanger}"
                            Content="{DynamicResource L.apps.btnRemove}" IsEnabled="False" />
                </StackPanel>
            </Grid>

            <StackPanel Name="AppsUninstallList" />
        </StackPanel>
    </Border>
</StackPanel>
