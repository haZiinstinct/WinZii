<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.diag.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.diag.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.diag.lead}" />

    <ItemsControl Name="DiagNotices" Margin="0,0,0,14" />

    <!-- Steuerung -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource L.diag.rangeLabel}" Style="{DynamicResource WzLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Name="DiagRange" Style="{DynamicResource WzComboBox}" Width="180" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Name="DiagSummary" Style="{DynamicResource WzLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,16,0,0">
                <Button Name="DiagBtnScan" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.diag.btnAnalyse}" />
                <Button Name="DiagBtnReport" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.diag.btnReport}" IsEnabled="False" />
                <Button Name="DiagBtnSfc" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.diag.btnSfc}" />
                <Button Name="DiagBtnDism" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.diag.btnDism}" />
                <Button Name="DiagBtnChkdsk" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.diag.btnChkdsk}" />
                <Button Name="DiagBtnBattery" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.diag.btnBattery}" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <!-- Auffälligkeiten -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.diag.eventsEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagEventsTitle" Text="{DynamicResource L.diag.notAnalysed}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DiagEvents" />
        </StackPanel>
    </Border>

    <!-- Startdauer -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.diag.bootEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagBootTitle" Text="{DynamicResource L.diag.notAnalysed}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DiagBoot" />
        </StackPanel>
    </Border>

    <!-- Zuverlässigkeitsverlauf -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.diag.reliabilityEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagReliabilityTitle" Text="{DynamicResource L.diag.notAnalysed}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.diag.reliabilityHint}" />
            <StackPanel Name="DiagReliability" />
        </StackPanel>
    </Border>

    <!-- Bluescreens -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.diag.crashEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagDumpsTitle" Text="{DynamicResource L.diag.notAnalysed}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DiagDumps" />
        </StackPanel>
    </Border>

    <!-- Datenträger -->
    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.diag.diskEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagDisksTitle" Text="{DynamicResource L.diag.notAnalysed}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DiagDisks" />
        </StackPanel>
    </Border>
</StackPanel>
