<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="// DIAGNOSE" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="Fehleranalyse" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="Ereignisprotokolle, Bluescreens und Datenträgerzustand — zusammengefasst und in Klartext übersetzt statt als Rohdaten." />

    <ItemsControl Name="DiagNotices" Margin="0,0,0,14" />

    <!-- Steuerung -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Zeitraum" Style="{DynamicResource WzLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Name="DiagRange" Style="{DynamicResource WzComboBox}" Width="180" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Name="DiagSummary" Style="{DynamicResource WzLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,16,0,0">
                <Button Name="DiagBtnScan" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,8"
                        Content="Analyse starten" />
                <Button Name="DiagBtnReport" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Bericht erstellen" IsEnabled="False" />
                <Button Name="DiagBtnSfc" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Systemdateien prüfen" />
                <Button Name="DiagBtnDism" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Windows-Abbild reparieren" />
                <Button Name="DiagBtnChkdsk" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Dateisystem prüfen" />
                <Button Name="DiagBtnBattery" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="Akkubericht" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <!-- Auffälligkeiten -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="// EREIGNISSE" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagEventsTitle" Text="Noch nicht analysiert" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DiagEvents" />
        </StackPanel>
    </Border>

    <!-- Startdauer -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="// STARTDAUER" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagBootTitle" Text="Noch nicht analysiert" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DiagBoot" />
        </StackPanel>
    </Border>

    <!-- Bluescreens -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="// ABSTÜRZE" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagDumpsTitle" Text="Noch nicht analysiert" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DiagDumps" />
        </StackPanel>
    </Border>

    <!-- Datenträger -->
    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Text="// DATENTRÄGER" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DiagDisksTitle" Text="Noch nicht analysiert" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DiagDisks" />
        </StackPanel>
    </Border>
</StackPanel>
