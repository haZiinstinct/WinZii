<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.drv.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.drv.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.drv.lead}" />

    <ItemsControl Name="DrvNotices" Margin="0,0,0,14" />

    <!-- Steuerung -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,16">
        <StackPanel>
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.drv.devicesEyebrow}" Style="{DynamicResource WzEyebrow}" />
                    <TextBlock Name="DrvTitle" Text="{DynamicResource L.drv.notChecked}" Style="{DynamicResource WzCardTitle}" />
                </StackPanel>
                <Button Name="DrvBtnScan" Style="{DynamicResource WzBtnPrimary}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Content="{DynamicResource L.drv.btnScan}" />
            </Grid>
            <TextBlock Style="{DynamicResource WzHint}"
                       Text="{DynamicResource L.drv.devicesHint}" />
        </StackPanel>
    </Border>

    <!-- Geräte mit Problemen -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.drv.problemEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DrvProblemsTitle" Text="{DynamicResource L.drv.notChecked}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DrvProblems" />
        </StackPanel>
    </Border>

    <!-- Treiber beschaffen -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.drv.obtainEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="{DynamicResource L.drv.obtainTitle}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                       Text="{DynamicResource L.drv.obtainHint}" />

            <ItemsControl Name="DrvObtainNotices" Margin="0,0,0,12" />

            <!-- Werkzeug des Herstellers -->
            <TextBlock Text="{DynamicResource L.drv.oemLabel}" Style="{DynamicResource WzLabel}" Margin="0,0,0,6" />
            <StackPanel Name="DrvOemRows" Margin="0,0,0,10" />
            <WrapPanel Margin="0,0,0,18">
                <Button Name="DrvBtnOemInstall" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,8"
                        IsEnabled="False" Content="{DynamicResource L.drv.btnOemInstall}" />
                <Button Name="DrvBtnOemScan" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,8"
                        IsEnabled="False" Content="{DynamicResource L.drv.btnOemScan}" />
                <Button Name="DrvBtnOemApply" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,8,8"
                        IsEnabled="False" Content="{DynamicResource L.drv.btnOemApply}" />
            </WrapPanel>

            <!-- Geräte ganz ohne Treiber -->
            <TextBlock Text="{DynamicResource L.drv.catalogLabel}" Style="{DynamicResource WzLabel}" Margin="0,0,0,6" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.drv.catalogHint}" />
            <StackPanel Name="DrvCatalogRows" />
        </StackPanel>
    </Border>

    <!-- Treiberliste -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.drv.inventoryEyebrow}" Style="{DynamicResource WzEyebrow}" />
                    <TextBlock Name="DrvListTitle" Text="{DynamicResource L.drv.notChecked}" Style="{DynamicResource WzCardTitle}" />
                </StackPanel>
                <CheckBox Name="DrvShowMicrosoft" Style="{DynamicResource WzToggle}"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Content="{DynamicResource L.drv.btnShowMicrosoft}"
                          ToolTip="{DynamicResource L.drv.tipShowMicrosoft}" />
            </Grid>
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.drv.inventoryHint}" />
            <StackPanel Name="DrvList" />
        </StackPanel>
    </Border>

    <!-- Sicherung -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.drv.backupEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="{DynamicResource L.drv.backupTitle}" Style="{DynamicResource WzCardTitle}" />
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.drv.backupHint}" />
            <StackPanel Name="DrvBackupInfo" />
            <WrapPanel Margin="0,10,0,0">
                <Button Name="DrvBtnExport" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,8,0"
                        Content="{DynamicResource L.drv.btnBackup}" />
                <Button Name="DrvBtnImport" Style="{DynamicResource WzBtnSecondary}"
                        Content="{DynamicResource L.drv.btnRestore}" IsEnabled="False" />
            </WrapPanel>
        </StackPanel>
    </Border>

    <!-- Vorhandene Sicherungen -->
    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.drv.existingEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Name="DrvBackupsTitle" Text="{DynamicResource L.drv.notChecked}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="DrvBackups" />
        </StackPanel>
    </Border>
</StackPanel>
