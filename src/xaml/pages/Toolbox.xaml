<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.tool.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.tool.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.tool.lead}" />

    <ItemsControl Name="ToolNotices" Margin="0,0,0,14" />

    <!-- Erst messen, dann reparieren -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
        <StackPanel>
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.tool.checkEyebrow}" Style="{DynamicResource WzEyebrow}" />
                    <TextBlock Name="NetDiagTitle" Text="{DynamicResource L.tool.checkTitle}" Style="{DynamicResource WzCardTitle}" />
                </StackPanel>
                <Button Name="ToolBtnNetDiag" Style="{DynamicResource WzBtnPrimary}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Content="{DynamicResource L.tool.btnCheck}" />
            </Grid>
            <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                       Text="{DynamicResource L.tool.checkHint}" />
            <StackPanel Name="NetDiagSteps" />
            <ItemsControl Name="NetDiagVerdict" Margin="0,10,0,0" />
        </StackPanel>
    </Border>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Netzwerk -->
        <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.tool.netEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="{DynamicResource L.tool.netTitle}" Style="{DynamicResource WzCardTitle}" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                           Text="{DynamicResource L.tool.netHint}" />
                <Button Name="ToolBtnRenew" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,0,8"
                        HorizontalAlignment="Left" Content="{DynamicResource L.tool.btnIpRenew}" />
                <Button Name="ToolBtnNetReset" Style="{DynamicResource WzBtnDanger}"
                        HorizontalAlignment="Left" Content="{DynamicResource L.tool.btnNetReset}" />

                <TextBlock Text="{DynamicResource L.tool.dnsTitle}" Style="{DynamicResource WzLabel}" Margin="0,18,0,6" />
                <WrapPanel>
                    <Button Name="ToolBtnDnsCloudflare" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,8" Content="Cloudflare" />
                    <Button Name="ToolBtnDnsQuad9" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,8" Content="Quad9" />
                    <Button Name="ToolBtnDnsGoogle" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,8" Content="Google" />
                    <Button Name="ToolBtnDnsAuto" Style="{DynamicResource WzBtnGhost}" Margin="0,0,8,8" Content="{DynamicResource L.tool.btnDnsRouter}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Windows Update -->
        <Border Grid.Row="0" Grid.Column="2" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.tool.updateEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="{DynamicResource L.tool.updateTitle}" Style="{DynamicResource WzCardTitle}" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                           Text="{DynamicResource L.tool.updateHint}" />
                <Button Name="ToolBtnWuReset" Style="{DynamicResource WzBtnPrimary}" HorizontalAlignment="Left"
                        Content="{DynamicResource L.tool.btnUpdateReset}" />

                <TextBlock Text="{DynamicResource L.tool.printerTitle}" Style="{DynamicResource WzLabel}" Margin="0,18,0,6" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                           Text="{DynamicResource L.tool.printerHint}" />
                <Button Name="ToolBtnSpooler" Style="{DynamicResource WzBtnSecondary}" HorizontalAlignment="Left"
                        Content="{DynamicResource L.tool.btnSpooler}" />

                <TextBlock Text="{DynamicResource L.tool.defenderTitle}" Style="{DynamicResource WzLabel}" Margin="0,18,0,6" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,10"
                           Text="{DynamicResource L.tool.defenderHint}" />
                <Button Name="ToolBtnScan" Style="{DynamicResource WzBtnSecondary}" HorizontalAlignment="Left"
                        Content="{DynamicResource L.tool.btnDefender}" />
            </StackPanel>
        </Border>

        <!-- Wiederherstellungspunkt -->
        <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.tool.restoreEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="{DynamicResource L.tool.restoreTitle}" Style="{DynamicResource WzCardTitle}" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                           Text="{DynamicResource L.tool.restoreHint}" />
                <Button Name="ToolBtnRestorePoint" Style="{DynamicResource WzBtnPrimary}" HorizontalAlignment="Left"
                        Content="{DynamicResource L.tool.btnRestorePoint}" />
            </StackPanel>
        </Border>

        <!-- Vorinstallierte Apps -->
        <Border Grid.Row="1" Grid.Column="2" Style="{DynamicResource WzCardStatic}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.tool.bloatEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="ToolBloatTitle" Text="{DynamicResource L.tool.bloatTitle}" Style="{DynamicResource WzCardTitle}" />
                <TextBlock Style="{DynamicResource WzHint}" Margin="0,0,0,12"
                           Text="{DynamicResource L.tool.bloatHint}" />
                <StackPanel Name="ToolBloatList" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Name="ToolBtnBloatScan" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,0" Content="{DynamicResource L.tool.btnBloatScan}" />
                    <Button Name="ToolBtnBloatRemove" Style="{DynamicResource WzBtnDanger}" Content="{DynamicResource L.tool.btnBloatRemove}" IsEnabled="False" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</StackPanel>
