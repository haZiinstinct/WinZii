<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.upd.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.upd.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.upd.lead}" />

    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.upd.stateTitle}" Style="{DynamicResource WzCardTitle}" />
            <StackPanel Name="UpdatesStateRows" />
        </StackPanel>
    </Border>

    <Border Style="{DynamicResource WzCardStatic}">
        <StackPanel>
            <TextBlock Name="UpdatesListTitle" Text="{DynamicResource L.upd.listTitle}" Style="{DynamicResource WzCardTitle}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="UpdatesSelection" Grid.Column="0" VerticalAlignment="Center"
                           Style="{DynamicResource WzValue}" Foreground="{DynamicResource WzCyan}"
                           Text="{DynamicResource L.upd.selectionCount}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="UpdatesBtnScan" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,0"
                            Content="{DynamicResource L.upd.btnScan}" />
                    <Button Name="UpdatesBtnAll" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,0"
                            Content="{DynamicResource L.upd.btnAll}" IsEnabled="False" />
                    <Button Name="UpdatesBtnNone" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,8,0"
                            Content="{DynamicResource L.upd.btnNone}" IsEnabled="False" />
                    <Button Name="UpdatesBtnInstall" Style="{DynamicResource WzBtnPrimary}"
                            Content="{DynamicResource L.upd.btnInstall}" IsEnabled="False" />
                </StackPanel>
            </Grid>

            <StackPanel Name="UpdatesList" />
        </StackPanel>
    </Border>
</StackPanel>
