<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{DynamicResource L.dash.eyebrow}" Style="{DynamicResource WzEyebrow}" />
    <TextBlock Text="{DynamicResource L.dash.title}" Style="{DynamicResource WzPageTitle}" />
    <TextBlock Style="{DynamicResource WzPageLead}"
               Text="{DynamicResource L.dash.lead}" />

    <!-- Hinweisleiste (Neustart ausstehend, FAT32 usw.) -->
    <ItemsControl Name="DashNotices" Margin="0,0,0,14" />

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.windowsEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DashOsTitle" Text="{DynamicResource L.dash.loading}" Style="{DynamicResource WzCardTitle}" TextWrapping="Wrap" />
                <StackPanel Name="DashOsRows" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.hardwareEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DashHwTitle" Text="{DynamicResource L.dash.loading}" Style="{DynamicResource WzCardTitle}" TextWrapping="Wrap" />
                <StackPanel Name="DashHwRows" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="4" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.securityEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DashSecTitle" Text="{DynamicResource L.dash.loading}" Style="{DynamicResource WzCardTitle}" TextWrapping="Wrap" />
                <StackPanel Name="DashSecRows" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.diskEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="{DynamicResource L.dash.diskTitle}" Style="{DynamicResource WzCardTitle}" />
                <StackPanel Name="DashDiskRows" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.networkEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="{DynamicResource L.dash.networkTitle}" Style="{DynamicResource WzCardTitle}" />
                <StackPanel Name="DashNetRows" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="4" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.sessionEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Text="{DynamicResource L.dash.sessionTitle}" Style="{DynamicResource WzCardTitle}" />
                <StackPanel Name="DashSessionRows" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.gpuEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DashGpuTitle" Text="{DynamicResource L.dash.loading}" Style="{DynamicResource WzCardTitle}" TextWrapping="Wrap" />
                <StackPanel Name="DashGpuRows" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.displayEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DashMonitorTitle" Text="{DynamicResource L.dash.loading}" Style="{DynamicResource WzCardTitle}" TextWrapping="Wrap" />
                <StackPanel Name="DashMonitorRows" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="4" Style="{DynamicResource WzCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.dash.firmwareEyebrow}" Style="{DynamicResource WzEyebrow}" />
                <TextBlock Name="DashFirmwareTitle" Text="{DynamicResource L.dash.loading}" Style="{DynamicResource WzCardTitle}" TextWrapping="Wrap" />
                <StackPanel Name="DashFirmwareRows" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Schnellaktionen -->
    <Border Style="{DynamicResource WzCardStatic}" Margin="0,4,0,0">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.dash.quickEyebrow}" Style="{DynamicResource WzEyebrow}" />
            <TextBlock Text="{DynamicResource L.dash.quickTitle}" Style="{DynamicResource WzCardTitle}" />
            <WrapPanel>
                <Button Name="DashBtnDiagnose" Style="{DynamicResource WzBtnPrimary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.dash.btnDiagnostics}" />
                <Button Name="DashBtnCleanup" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.dash.btnCleanup}" />
                <Button Name="DashBtnOptimize" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.dash.btnOptimizer}" />
                <Button Name="DashBtnAi" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.dash.btnAiRemoval}" />
                <Button Name="DashBtnRefresh" Style="{DynamicResource WzBtnSecondary}" Margin="0,0,10,8"
                        Content="{DynamicResource L.dash.btnRefresh}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</StackPanel>
