<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinZii" Height="820" Width="1280" MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0F"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             Seitenleiste
             ============================================================ -->
        <Border Grid.Column="0" Background="#06060A" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Wortmarke -->
                <StackPanel Grid.Row="0" Margin="22,26,22,20">
                    <TextBlock FontSize="25" FontWeight="Bold"
                               FontFamily="{DynamicResource WzFontMono}">
                        <Run Text="Win" Foreground="#00D4FF" /><Run Text="Z" Foreground="#F8FAFC" /><Run Text="ii" Foreground="#00D4FF" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Ellipse Style="{DynamicResource WzPulseDot}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L.app.subtitle}" Margin="7,0,0,0"
                                   FontFamily="{DynamicResource WzFontMono}" FontSize="10.5"
                                   Foreground="#00D4FF" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,0">
                    <StackPanel Name="NavPanel">
                        <TextBlock Text="{DynamicResource L.nav.groupSystem}" Style="{DynamicResource WzEyebrow}" Margin="14,8,0,6" />
                        <Button Name="NavDashboard" Tag="Dashboard" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.dashboard}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavDiagnostics" Tag="Diagnostics" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.diagnostics}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource L.nav.groupOptimize}" Style="{DynamicResource WzEyebrow}" Margin="14,16,0,6" />
                        <Button Name="NavOptimizer" Tag="Optimizer" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.optimizer}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavAiRemoval" Tag="AiRemoval" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE99A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.aiRemoval}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavCleanup" Tag="Cleanup" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.cleanup}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavAutostart" Tag="Autostart" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.autostart}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource L.nav.groupInstall}" Style="{DynamicResource WzEyebrow}" Margin="14,16,0,6" />
                        <Button Name="NavApps" Tag="Apps" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xECAA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.apps}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavUninstall" Tag="Uninstall" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.uninstall}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavOffice" Tag="Office" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.office}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource L.nav.groupTakeover}" Style="{DynamicResource WzEyebrow}" Margin="14,16,0,6" />
                        <Button Name="NavUserData" Tag="UserData" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.userData}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavRestore" Tag="Restore" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.restore}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavDrivers" Tag="Drivers" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.drivers}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource L.nav.groupTools}" Style="{DynamicResource WzEyebrow}" Margin="14,16,0,6" />
                        <Button Name="NavToolbox" Tag="Toolbox" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.toolbox}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="NavProtocol" Tag="Protocol" Style="{DynamicResource WzNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.protocol}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Fußzeile: Sprache, Version und haZii-Credit -->
                <StackPanel Grid.Row="2" Margin="22,16,22,18">
                    <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,14" />
                    <!-- Bewusst ein Knopf statt eines Auswahlfelds: In der Fußzeile
                         steht sonst kein einziges umrandetes Bedienelement, und ein
                         Kasten neben dem Credit stört dessen Ruhe. Das Menü baut
                         main.ps1 aus den vorhandenen Sprachdateien. -->
                    <Button Name="LanguagePicker" Style="{DynamicResource WzBtnGhost}"
                            HorizontalAlignment="Left" Margin="0,0,0,12"
                            Padding="8,3,10,3" FontSize="11.5"
                            ToolTip="{DynamicResource L.app.languageTip}" />
                    <TextBlock Name="SidebarVersion" Text="v0.3.0"
                               FontFamily="{DynamicResource WzFontMono}" FontSize="10.5"
                               Foreground="{DynamicResource WzTextFaint}" Margin="0,0,0,7" />
                    <TextBlock Name="HaziiBadge" FontFamily="{DynamicResource WzFontMono}" FontSize="11.5" Cursor="Hand"
                               ToolTip="https://hazii.org">
                        <Run Text="// code:" Foreground="#94A3B8" /><Run Text=" " Foreground="#94A3B8" /><Run Text="ha" Foreground="#00D4FF" FontWeight="Bold" /><Run Text="Z" Foreground="#F8FAFC" FontWeight="Bold" /><Run Text="ii" Foreground="#00D4FF" FontWeight="Bold" /><Run Text=".org" Foreground="#00A8CC" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             Hauptbereich
             ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Kopfleiste (zugleich Fenstergriff) -->
            <Grid Grid.Row="0" Background="#0A0A0F">
                <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <Border Background="#12121A" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="999" Padding="11,3,11,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE977;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" Foreground="{DynamicResource WzTextFaint}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Name="HeaderHost" Text="COMPUTERNAME"
                                       FontFamily="{DynamicResource WzFontMono}" FontSize="10.5"
                                       Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#1A00D4FF" BorderBrush="#3300D4FF" BorderThickness="1"
                            CornerRadius="999" Padding="11,3,11,3" Margin="9,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{DynamicResource WzPulseDot}" Width="6" Height="6" VerticalAlignment="Center" />
                            <TextBlock Name="HeaderOs" Text="WINDOWS" Margin="7,0,0,0"
                                       FontFamily="{DynamicResource WzFontMono}" FontSize="10.5"
                                       Foreground="#00D4FF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Name="DryRunBadge" Background="#14F59E0B" BorderBrush="#4DF59E0B" BorderThickness="1"
                            CornerRadius="999" Padding="11,3,11,3" Margin="9,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource L.shell.dryRunBadge}" FontFamily="{DynamicResource WzFontMono}"
                                   FontSize="10.5" Foreground="#F59E0B" />
                    </Border>
                </StackPanel>

                <!-- Fenstersteuerung -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Name="BtnMinimize" Style="{DynamicResource WzBtnGhost}" Width="44" Padding="0"
                            Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    <Button Name="BtnMaximize" Style="{DynamicResource WzBtnGhost}" Width="44" Padding="0"
                            Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    <Button Name="BtnClose" Style="{DynamicResource WzBtnGhost}" Width="46" Padding="0"
                            Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                </StackPanel>
            </Grid>

            <!-- Seiteninhalt -->
            <ScrollViewer Grid.Row="1" Name="PageScroller" VerticalScrollBarVisibility="Auto"
                          Padding="30,26,30,26">
                <ContentControl Name="PageHost" />
            </ScrollViewer>

            <!-- Log-Konsole -->
            <Border Grid.Row="2" Name="LogHeader" Background="#06060A" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
                <Grid Height="34">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                        <TextBlock Text="{DynamicResource L.shell.consoleEyebrow}" FontFamily="{DynamicResource WzFontMono}"
                                   FontSize="10.5" Foreground="#00D4FF" VerticalAlignment="Center" />
                        <TextBlock Name="LogHint" Text="{DynamicResource L.shell.consoleHint}" Margin="12,0,0,0"
                                   FontFamily="{DynamicResource WzFontMono}" FontSize="10.5"
                                   Foreground="{DynamicResource WzTextFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Button Name="BtnClearLog" Style="{DynamicResource WzBtnGhost}" Content="{DynamicResource L.shell.consoleClear}" />
                        <TextBlock Name="LogChevron" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10.5" Foreground="{DynamicResource WzTextFaint}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <RichTextBox Grid.Row="3" Name="LogConsole" Height="150"
                         Style="{DynamicResource WzLogConsole}" />

            <!-- Statusleiste -->
            <Grid Grid.Row="4" Background="#06060A">
                <Border BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" />
                <ProgressBar Name="BusyBar" Style="{DynamicResource WzProgress}" VerticalAlignment="Top"
                             Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Name="StatusText" Text="{DynamicResource L.shell.statusReady}"
                               FontFamily="{DynamicResource WzFontMono}" FontSize="10.5"
                               Foreground="#94A3B8" VerticalAlignment="Center" />
                    <Button Name="BtnCancelTask" Style="{DynamicResource WzBtnGhost}" Content="{DynamicResource L.shell.cancel}"
                            FontSize="10.5" Padding="8,1,8,1" Margin="12,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="{DynamicResource L.shell.cancelTip}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,0">
                    <CheckBox Name="DryRunToggle" Style="{DynamicResource WzToggle}" Content="{DynamicResource L.shell.dryRun}"
                              ToolTip="{DynamicResource L.shell.dryRunTip}" />
                    <TextBlock Name="StatusPath" Text="" Margin="18,0,0,0"
                               FontFamily="{DynamicResource WzFontMono}" FontSize="10.5"
                               Foreground="{DynamicResource WzTextFaint}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
