<Configuration>
  <!--
    Windows Sandbox mit Schreibrecht auf den WinZii-Ordner.

    Nötig für alles, was etwas ablegt: Treibersicherung, Übernahme-Bericht,
    Übergabeblatt, Protokolle, Offline-Installer. Die Sandbox selbst wird beim
    Schließen verworfen — der eingebundene Ordner aber nicht. Was hier
    geschrieben wird, landet wirklich im Arbeitsverzeichnis.

    Wer nur die Oberfläche ansehen will, nimmt WinZii.wsb; das bindet
    denselben Ordner schreibgeschützt ein.

    ACHTUNG: Eingebunden wird der GANZE Ordner, mit Netz — auch backups\
    mit WLAN- und BitLocker-Schlüsseln im Klartext, logs\ und reports\.
    Was in der Sandbox läuft, kann das lesen und verändern. Vorher backups\
    wegräumen oder nur eine Kopie ohne diese Ordner einbinden
    (Audit 2026-10, M39).

    HostFolder steht relativ zu dieser Datei — ".." ist der WinZii-Ordner.
    Sollte Windows das ablehnen, hier den vollständigen Pfad eintragen.

    Voraussetzung, einmalig und mit Neustart:
      Enable-WindowsOptionalFeature -Online -FeatureName Containers-DisposableClientVM -All
  -->
  <VGpu>Disable</VGpu>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>..</HostFolder>
      <SandboxFolder>C:\WinZii</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c echo ACHTUNG: C:\WinZii ist beschreibbar - Aenderungen landen im echten Ordner. Start.bat startet WinZii.</Command>
  </LogonCommand>
</Configuration>
