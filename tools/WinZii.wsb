<Configuration>
  <!--
    Windows Sandbox zum gefahrlosen Ausprobieren — schreibgeschützt.

    Die Sandbox bringt kein winget mit; damit lässt sich die Nachinstallation
    testen. Der Ordner wird schreibgeschützt eingebunden, damit Testläufe das
    Arbeitsverzeichnis nicht verändern. Für alles, was schreiben muss
    (Treibersicherung, Berichte, Protokolle), gibt es WinZii-Schreibend.wsb.

    HostFolder steht relativ zu dieser Datei — ".." ist der WinZii-Ordner.
    Sollte Windows das ablehnen, hier den vollständigen Pfad eintragen.

    Voraussetzung, einmalig und mit Neustart:
      Enable-WindowsOptionalFeature -Online -FeatureName Containers-DisposableClientVM -All

    Aufruf: Doppelklick auf diese Datei (Windows Pro oder Enterprise).
  -->
  <VGpu>Disable</VGpu>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>..</HostFolder>
      <SandboxFolder>C:\WinZii</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c echo WinZii liegt unter C:\WinZii - zum Start dort Start.bat ausfuehren.</Command>
  </LogonCommand>
</Configuration>
