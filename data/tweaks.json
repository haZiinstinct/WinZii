      "description": "Löscht die Copilot-App-Pakete für alle Benutzer und entfernt sie aus der Bereitstellung für neue Konten. Nach großen Funktionsupdates können sie zurückkehren — dann erneut ausführen. Windows richtet nach dem Entfernen bei der nächsten Anmeldung Teile neu ein — das kostet einmalig ein paar Minuten Rechenzeit.",
      "defaultChecked": true,
      "appliesTo": "all",
      "requiresReboot": false,
      "sourceRef": "zoicware/RemoveWindowsAI",
      "actions": [
        {
          "type": "appx",
          "patterns": [
            "Microsoft.Copilot*",
            "Microsoft.Windows.Copilot*",
            "MicrosoftWindows.Client.AIX*",
            "MicrosoftWindows.Client.CoPilot*",
            "*Ai.Copilot*"
          ],
          "removeProvisioned": true,
          "allUsers": true,
          "undo": {
            "hint": "Copilot lässt sich bei Bedarf über den Microsoft Store neu installieren"
          }
        }
      ]
    },
