    {
      "id": "tele-diagtrack",
      "category": "telemetry",
      "level": "soft",
      "risk": "low",
      "name": "Telemetriedienste abschalten",
      "description": "Beendet die Dienste, die Nutzungsdaten sammeln und übertragen (DiagTrack und dmwappushservice). Nebenwirkung: Feedback-Hub und Windows-Insider arbeiten danach nicht mehr, und auf verwalteten Geräten bricht die Synchronisierung mit Intune oder einer anderen Geräteverwaltung.",
      "defaultChecked": true,
      "appliesTo": "all",
      "requiresReboot": false,
      "actions": [
        {
          "type": "service",
          "serviceName": "DiagTrack",
          "startupType": "Disabled",
          "stop": true
        },
        {
          "type": "service",
          "serviceName": "dmwappushservice",
          "startupType": "Disabled",
          "stop": true
        }
      ]
    },
