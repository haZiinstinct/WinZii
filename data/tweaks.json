    {
      "id": "security",
      "name": "Sicherheit",
      "description": "Veraltete Protokolle abschalten, Angriffsflächen verkleinern."
    },
    {
      "id": "ai-policy",
      "name": "KI abschalten",
      "description": "Sperrt Copilot, Recall und die KI-Funktionen in Windows-Programmen per Richtlinie. Umkehrbar und auch dann sinnvoll, wenn noch nichts installiert ist."
    },
    {
      "id": "ai-remove",
      "name": "KI entfernen",
      "description": "Löscht die KI-Bestandteile wirklich vom System. Nicht per Knopfdruck umkehrbar."
    }
  ],
  "tweaks": [
    {
      "id": "perf-fast-startup-off",
      "category": "performance",
      "level": "soft",
      "risk": "medium",
      "name": "Schnellstart abschalten",
      "description": "Der Schnellstart fährt Windows nur scheinbar herunter. Das verursacht Probleme mit Treibern, Updates und Dual-Boot — und Neustarts helfen dann nicht mehr bei der Fehlersuche. Der Preis: Ohne Schnellstart dauert jeder Kaltstart zehn bis dreißig Sekunden länger. Bei Treiber- oder Update-Problemen und bei Dual-Boot lohnt sich das — sonst besser eingeschaltet lassen.",
      "defaultChecked": false,
      "appliesTo": "all",
      "requiresReboot": false,
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
          "name": "HiberbootEnabled",
          "valueType": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "perf-startup-delay",
      "category": "performance",
      "level": "soft",
      "risk": "medium",
      "name": "Verzögerung der Autostart-Programme entfernen",
      "description": "Windows wartet nach der Anmeldung künstlich etwa zehn Sekunden, bevor Autostart-Programme laufen. Auf schnellen PCs ist das unnötig. Auf schwacher Hardware dagegen kontraproduktiv: Alle Autostart-Programme starten dann gleichzeitig mit dem Desktop, und die erste Minute nach der Anmeldung fühlt sich zäher an. Wirkt ab der nächsten Anmeldung.",
      "defaultChecked": false,
      "appliesTo": "all",
      "requiresReboot": true,
      "actions": [
        {
          "type": "registry",
          "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
          "name": "StartupDelayInMSec",
          "valueType": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "perf-menu-delay",
      "category": "performance",
      "level": "soft",
      "risk": "low",
      "name": "Menüs sofort öffnen",
      "description": "Setzt die Verzögerung beim Aufklappen von Menüs von 400 auf 0 Millisekunden. Windows fühlt sich spürbar direkter an.",
      "defaultChecked": true,
      "appliesTo": "all",
      "requiresReboot": true,
      "actions": [
        {
          "type": "registry",
          "path": "HKCU:\\Control Panel\\Desktop",
          "name": "MenuShowDelay",
          "valueType": "String",
          "value": "0"
        }
      ]
    },
    {
      "id": "perf-gamedvr-off",
      "category": "performance",
      "level": "soft",
      "risk": "low",
      "name": "Xbox-Spieleaufzeichnung abschalten",
      "description": "Die Hintergrundaufzeichnung (Game DVR) läuft auch bei normalen Programmen mit und kostet Leistung. Wird für Spiele selbst nicht benötigt.",
      "defaultChecked": true,
      "appliesTo": "all",
      "requiresReboot": false,
      "actions": [
        {
          "type": "registry",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR",
          "name": "AllowGameDVR",
          "valueType": "DWord",
          "value": 0
        },
        {
          "type": "registry",
          "path": "HKCU:\\System\\GameConfigStore",
          "name": "GameDVR_Enabled",
          "valueType": "DWord",
          "value": 0
        },
        {
          "type": "registry",
          "path": "HKCU:\\Software\\Microsoft\\GameBar",
          "name": "UseNexusForGameBarEnabled",
          "valueType": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "perf-transparency-off",
      "category": "performance",
      "level": "soft",
      "risk": "low",
      "name": "Transparenzeffekte abschalten",
      "description": "Die Milchglas-Effekte von Startmenü und Taskleiste kosten Grafikleistung. Auf älteren PCs und Notebooks merklich.",
      "defaultChecked": true,
      "appliesTo": "all",
      "requiresReboot": false,
      "actions": [
        {
          "type": "registry",
          "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
          "name": "EnableTransparency",
          "valueType": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "perf-animations-off",
      "category": "performance",
      "level": "soft",
      "risk": "medium",
      "name": "Fensteranimationen abschalten",
      "description": "Schaltet Ein- und Ausblendeffekte ab. Deutlich schneller auf schwacher Hardware, sieht dafür nüchterner aus.",
      "defaultChecked": false,
      "appliesTo": "all",
      "requiresReboot": true,
      "actions": [
        {
          "type": "registry",
          "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
          "name": "VisualFXSetting",
          "valueType": "DWord",
          "value": 2
        },
        {
          "type": "registry",
          "path": "HKCU:\\Control Panel\\Desktop\\WindowMetrics",
          "name": "MinAnimate",
          "valueType": "String",
          "value": "0"
        }
      ]
    },
    {
      "id": "perf-power-high",
      "category": "performance",
      "level": "soft",
      "risk": "low",
      "name": "Energiesparplan auf Höchstleistung",
      "description": "Verhindert, dass der Prozessor im Leerlauf zu stark heruntertaktet. Bei Notebooks im Akkubetrieb sinkt dadurch die Laufzeit.",
      "defaultChecked": false,
      "appliesTo": "all",
      "requiresReboot": false,
      "actions": [
        {
          "type": "command",
          "exec": "powercfg.exe",
          "args": "/setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c",
          "undoCapture": {
            "exec": "powercfg.exe",
            "args": "/getactivescheme",
            "pattern": "([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
            "argsFormat": "/setactive {0}"
          },
          "failHint": "Der Höchstleistungsplan ist auf diesem Gerät nicht vorhanden — auf Notebooks mit modernem Standby ist das normal, die Einstellung ist dort gegenstandslos.",
          "undo": {
            "exec": "powercfg.exe",
            "args": "/setactive 381b4222-f694-41f0-9685-ff5bb260df2e"
          }
        }
      ]
    },
    {
      "id": "perf-sysmain-off",
      "category": "performance",
      "level": "soft",
      "risk": "medium",
      "name": "SysMain (Superfetch) abschalten",
      "description": "SysMain lädt häufig genutzte Programme vorab in den Arbeitsspeicher. Auf SSDs bringt das kaum etwas und verursacht dauerhafte Hintergrundlast. Auf Festplatten besser eingeschaltet lassen.",
      "defaultChecked": false,
      "appliesTo": "all",
      "requiresReboot": false,
      "actions": [
        {
          "type": "service",
          "serviceName": "SysMain",
          "startupType": "Disabled",
          "stop": true
        }
      ]
    },
